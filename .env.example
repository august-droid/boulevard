EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/import-songs.mjs and scripts/generate-songs.mjs
# (server-side, bypasses RLS). Never expose this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Suno v5.5 — generation pipeline only.
SUNO_API_KEY=your-suno-api-key
# Optional override; defaults to https://api.suno.ai
SUNO_BASE_URL=

# Cloudflare R2 — for durable audio hosting (optional until you wire it up).
# When set, scripts/generate-songs.mjs will upload Suno output here and
# store the R2 URL on the song row instead of the Suno CDN URL.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# RevenueCat — in-app subscription billing.
# Sign up at https://app.revenuecat.com, create a project for Boulevard,
# attach the Play Console (Android) and App Store Connect (iOS) apps.
# These are the *public* (client-side) SDK keys; safe to ship in the bundle.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
