{
  "expo": {
    "name": "Boulevard",
    "slug": "boulevard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "boulevard",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0c",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "cover",
      "backgroundColor": "#0a0a0c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.boulevard.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.boulevard.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0c"
      },
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.google.android.gms.permission.AD_ID",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0a0a0c",
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/listen"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#c8ae7a"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "react-native-appsflyer"
    ],
    "extra": {
      "eas": {
        "projectId": "a57e1fbb-bfb5-443b-8f4a-643f55d809ad"
      }
    },
    "owner": "magnagrowth"
  }
}
